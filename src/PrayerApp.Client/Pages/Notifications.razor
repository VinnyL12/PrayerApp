@page "/notifications"
@attribute [Authorize]
@inject PrayerApiClient Api
@inject NotificationState State
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Notifications · Prayer App</PageTitle>

<div class="readable">

<header class="row page-header">
    <h1>Notifications</h1>
    @if (_list is { UnreadCount: > 0 })
    {
        <button class="button button-quiet button-small" @onclick="MarkAllReadAsync">Mark all read</button>
    }
</header>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_groups is null)
{
    <p class="muted">Loading…</p>
}
else if (_groups.Count == 0)
{
    <div class="card empty">
        <p>Nothing yet. When someone responds to your posts, or a post you responded to gets an update, you'll see it here.</p>
    </div>
}
else
{
    <ul class="notifications">
        @foreach (var group in _groups)
        {
            <li @key="(group.PostId, group.Type)">
                <button class="card notification @(group.UnreadCount > 0 ? "unread" : "")" @onclick="() => OpenAsync(group)">
                    <span>
                        @Headline(group)
                        <span class="notification-excerpt">“@group.Excerpt”</span>
                    </span>
                    <span class="muted small time">@TimeFormat.Ago(group.Latest, Time.GetUtcNow())</span>
                </button>
            </li>
        }
    </ul>
}
</div>

@code {
    /// <summary>All notifications of one kind about one post, collapsed into a single row.</summary>
    private sealed record NotificationGroup(
        int PostId, NotificationType Type, string Excerpt, int Count, int UnreadCount, DateTimeOffset Latest,
        IReadOnlyList<NotificationDto> Items);

    private NotificationList? _list;
    private List<NotificationGroup>? _groups;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetNotificationsAsync();
        _list = result.Value;
        _error = result.Error;

        // Group by (post, kind), a hash-based GroupBy, O(n), so "your post was hidden"
        // never folds into a response count. Then order groups by their most recent
        // activity so the list still reads newest-first.
        _groups = _list?.Items
            .GroupBy(n => (n.PostId, n.Type))
            .Select(g => new NotificationGroup(
                g.Key.PostId,
                g.Key.Type,
                g.First().PostExcerpt,
                g.Count(),
                g.Count(n => !n.IsRead),
                g.Max(n => n.CreatedAt),
                g.ToList()))
            .OrderByDescending(g => g.Latest)
            .ToList();
    }

    private static string Headline(NotificationGroup group)
    {
        if (group.Type == NotificationType.PostHidden)
        {
            return "An admin hid your post";
        }

        if (group.Type == NotificationType.PostUpdated)
        {
            var updates = group.UnreadCount > 0 ? group.UnreadCount : group.Count;
            var isNew = group.UnreadCount > 0 ? "New update" : "Update";
            return updates == 1 ? $"{isNew} on a post you responded to" : $"{updates} {isNew.ToLowerInvariant()}s on a post you responded to";
        }

        var count = group.UnreadCount > 0 ? group.UnreadCount : group.Count;
        var fresh = group.UnreadCount > 0 ? "new " : "";
        return count == 1 ? $"1 {fresh}response to" : $"{count} {fresh}responses to";
    }

    private async Task OpenAsync(NotificationGroup group)
    {
        var unread = group.Items.Where(n => !n.IsRead).ToList();
        if (unread.Count > 0)
        {
            await Task.WhenAll(unread.Select(n => Api.MarkNotificationReadAsync(n.Id)));
            await State.RefreshAsync();
        }

        Navigation.NavigateTo($"/posts/{group.PostId}");
    }

    private async Task MarkAllReadAsync()
    {
        var result = await Api.MarkAllNotificationsReadAsync();
        _error = result.Error;
        await LoadAsync();
        await State.RefreshAsync();
    }
}
