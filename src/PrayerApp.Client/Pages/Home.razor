@page "/"
@inject PrayerApiClient Api

<PageTitle>Seventh Haven</PageTitle>

<AuthorizeView>
    <Authorized>
        @* Signed in: the same seven-step staircase as the landing page, now live. Every
           community is a step; the ones you haven't joined are shown as clear glass. *@
        <section class="landing landing-home">
            <div class="landing-copy">
                <p class="landing-greeting">@Greeting(), @FirstName(context.User.Identity?.Name)</p>
                <h1>Your seven havens.</h1>
                <p class="lead">Thank you for showing up for each other today.</p>

                <dl class="haven-stats">
                    <div>
                        <dt>Joined</dt>
                        <dd>@(_communities is null ? "–" : $"{_communities.Count(c => c.IsMember)} of {_communities.Count}")</dd>
                    </div>
                    <div>
                        <dt>Posts</dt>
                        <dd>@(_myPosts?.Count.ToString() ?? "–")</dd>
                    </div>
                    <div>
                        <dt>Responses</dt>
                        <dd>@(_myPosts?.Sum(p => p.AcknowledgmentCount).ToString() ?? "–")</dd>
                    </div>
                </dl>
            </div>

            @if (_communities is null)
            {
                <p class="muted landing-status">@(_error ?? "Loading…")</p>
            }
            else
            {
                <ol class="havens" aria-label="Communities">
                    @for (var i = 0; i < _communities.Count; i++)
                    {
                        var community = _communities[i];
                        <li @key="community.Id" class="haven @(community.IsMember ? "" : "haven-open")" style="--i: @i">
                            <a href="/communities/@community.Id">
                                <span class="haven-number" aria-hidden="true">@(i + 1)</span>
                                <span class="haven-body">
                                    <span class="haven-name">@community.Name</span>
                                    <span class="haven-blurb">@community.Description</span>
                                    <span class="haven-meta">
                                        @if (community.IsMember)
                                        {
                                            @community.MemberCount @(community.MemberCount == 1 ? "member" : "members")
                                        }
                                        else
                                        {
                                            <text>Not joined yet</text>
                                        }
                                    </span>
                                </span>
                            </a>
                        </li>
                    }
                </ol>
            }
        </section>
    </Authorized>
    <NotAuthorized>
        @* The landing page is built on the name: seven communities, drawn as seven steps
           that rise to the seventh. The headline sits in the open space above the short ones. *@
        <section class="landing">
            <div class="landing-copy">
                <h1>Seven havens.<br />One for whatever you're carrying.</h1>
                <p class="lead">
                    A small, private place to share what's on your heart. People answer with a few
                    kind words, never comments. Open to every faith.
                </p>
                <div class="hero-actions">
                    <a class="button" href="/register">Create an account</a>
                    <a class="button button-quiet" href="/login">Sign in</a>
                </div>
            </div>

            <ol class="havens" aria-label="The seven communities">
                @for (var i = 0; i < Havens.Length; i++)
                {
                    var haven = Havens[i];
                    <li class="haven" style="--i: @i">
                        <a href="/register" aria-label="@haven.Name: @haven.Blurb Create an account to join.">
                            <span class="haven-number" aria-hidden="true">@(i + 1)</span>
                            <span class="haven-body">
                                <span class="haven-name">@haven.Name</span>
                                <span class="haven-blurb">@haven.Blurb</span>
                            </span>
                        </a>
                    </li>
                }
            </ol>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The seven communities, as the API seeds them. Listed here so a signed-out visitor
    // sees them instantly, without an API call (the communities endpoint needs sign-in).
    private static readonly (string Name, string Blurb)[] Havens =
    [
        ("General", "Anything on your heart that doesn't fit elsewhere."),
        ("Health & Healing", "Illness, recovery, surgery, and caring for someone who is unwell."),
        ("Grief & Loss", "Losing someone or something, and learning to carry it."),
        ("Family & Relationships", "Marriage, parenting, family strain, and friendships."),
        ("Work & Finances", "Job searches, money pressure, and decisions about work."),
        ("Mental & Emotional Wellbeing", "Anxiety, depression, loneliness, and stress."),
        ("Gratitude & Answered Prayers", "Share what went right and give thanks."),
    ];

    private List<CommunityDto>? _communities;
    private List<PostDto>? _myPosts;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if ((await AuthState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        // Both requests in flight at once, like Promise.all.
        var communitiesTask = Api.GetCommunitiesAsync();
        var postsTask = Api.GetMyPostsAsync();
        await Task.WhenAll(communitiesTask, postsTask);

        var communities = await communitiesTask;
        // All of them, in a fixed order, so each community keeps its step number.
        _communities = communities.Value?.OrderBy(c => c.Id).ToList();
        _myPosts = (await postsTask).Value;
        _error = communities.Error;
    }

    private static string Greeting() => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening",
    };

    private static string FirstName(string? name) =>
        name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "friend";
}
