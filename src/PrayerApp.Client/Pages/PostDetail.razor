@page "/posts/{Id:int}"
@attribute [Authorize]
@inject PrayerApiClient Api

<PageTitle>Post · Seventh Haven</PageTitle>

<div class="readable">

@if (_post is null)
{
    <p class="@(_error is null ? "muted" : "error")">@(_error ?? "Loading…")</p>
}
else
{
    @* Every page needs an h1: App.razor's FocusOnNavigate moves screen-reader focus to it
       after navigation. The post card already shows this visually, so it's hidden. *@
    <h1 class="visually-hidden">Post in @_post.CommunityName</h1>
    <p><a href="/communities/@_post.CommunityId">← Back to community</a></p>

    <PostCard Post="_post" PostChanged="p => _post = p" ShowLink="false" />

    <PostUpdates Post="_post" PostChanged="p => _post = p" />

    @if (_post.IsMine)
    {
        <section class="card">
            <h2>Responses</h2>
            <AcknowledgmentBreakdown PostId="_post.Id" />
        </section>
    }
}
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PostDto? _post;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetPostAsync(Id);
        _post = result.Value;
        _error = result.Error;
    }
}
