@page "/communities"
@attribute [Authorize]
@inject PrayerApiClient Api

<PageTitle>Communities · Prayer App</PageTitle>

<header class="page-hero">
    <span class="eyebrow">Communities</span>
    <h1>Find your people</h1>
    <p>Join the communities that fit what you're carrying. You'll see posts only from the ones you belong to.</p>
</header>

@if (_error is not null)
{
    <p class="error center">@_error</p>
}

@if (_communities is null)
{
    <p class="muted center">Loading…</p>
}
else
{
    <div class="tile-grid">
        @foreach (var community in _communities)
        {
            <CommunityTile @key="community.Id" Community="community" OnToggle="ToggleAsync" Busy="@(_busyId == community.Id)" />
        }
    </div>
}

@code {
    private List<CommunityDto>? _communities;
    private string? _error;
    private int? _busyId;

    // Like useEffect(() => { load() }, []): runs once when the page first renders.
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetCommunitiesAsync();
        _communities = result.Value;
        _error = result.Error;
    }

    private async Task ToggleAsync(CommunityDto community)
    {
        _busyId = community.Id;
        _error = null;

        var result = community.IsMember
            ? await Api.LeaveAsync(community.Id)
            : await Api.JoinAsync(community.Id);

        if (result.Succeeded)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Error;
        }

        _busyId = null;
    }
}
