@page "/register"
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Join · Prayer App</PageTitle>

<section class="auth-card card">
    <h1>Join Prayer App</h1>
    <p class="muted">A quiet place to ask for and offer support. Every faith is welcome.</p>

    <EditForm Model="_request" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <label for="name">Display name</label>
        <InputText id="name" class="input" autocomplete="nickname" @bind-Value="_request.DisplayName" />
        <p class="muted small">Shown on your posts unless you post anonymously.</p>
        <ValidationMessage For="() => _request.DisplayName" class="error small" />

        <label for="email">Email</label>
        <InputText id="email" class="input" type="email" autocomplete="email" @bind-Value="_request.Email" />
        <ValidationMessage For="() => _request.Email" class="error small" />

        <label for="password">Password</label>
        <InputText id="password" class="input" type="password" autocomplete="new-password" @bind-Value="_request.Password" />
        <p class="muted small">At least 8 characters, with a number and upper- and lowercase letters.</p>
        <ValidationMessage For="() => _request.Password" class="error small" />

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <button type="submit" class="button button-block" disabled="@_busy">@(_busy ? "Creating account…" : "Create account")</button>
    </EditForm>

    <p class="muted small center">Already have an account? <a href="/login">Sign in</a></p>
</section>

@code {
    private readonly RegisterRequest _request = new() { Email = "", Password = "", DisplayName = "" };
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.RegisterAsync(_request);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/communities");
        }
        else
        {
            _error = result.Error;
            _busy = false;
        }
    }
}
