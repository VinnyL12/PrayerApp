@* A compact, horizontal community card: icon | name, one-line description, members | action.
   Fixed height regardless of text length, so a grid of them stays even and fits on one screen. *@
<article class="community-tile @(Community.IsMember ? "is-member" : "")">
    <a class="tile-main" href="/communities/@Community.Id" aria-label="Open @Community.Name">
        <CommunityIcon Category="Community.Category" />
        <span class="tile-text">
            <span class="tile-name">@Community.Name</span>
            <span class="tile-description">@Community.Description</span>
            <span class="member-count">@Community.MemberCount @(Community.MemberCount == 1 ? "member" : "members")</span>
        </span>
    </a>

    <div class="tile-action">
        @if (OnToggle.HasDelegate)
        {
            @if (Community.IsMember)
            {
                <button class="button button-quiet button-small" disabled="@Busy" @onclick="() => OnToggle.InvokeAsync(Community)">Leave</button>
            }
            else
            {
                <button class="button button-small" disabled="@Busy" @onclick="() => OnToggle.InvokeAsync(Community)">Join</button>
            }
        }
        else
        {
            <a class="tile-chevron" href="/communities/@Community.Id" tabindex="-1" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
            </a>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public CommunityDto Community { get; set; } = default!;

    /// <summary>When set, the tile shows Join/Leave; otherwise a chevron into the community.</summary>
    [Parameter] public EventCallback<CommunityDto> OnToggle { get; set; }

    [Parameter] public bool Busy { get; set; }
}
