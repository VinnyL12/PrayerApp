@implements IDisposable
@inject NotificationState Notifications
@inject LiveConnection Live

<NavLink href="/notifications" class="bell" title="Notifications" aria-label="@AriaLabel">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
    </svg>
    @if (Notifications.UnreadCount > 0)
    {
        <span class="badge" aria-hidden="true">@(Notifications.UnreadCount > 99 ? "99+" : Notifications.UnreadCount)</span>
    }
</NavLink>

@code {
    // Only used while the live connection is down (API restarting, network blip).
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);
    private readonly CancellationTokenSource _stop = new();

    // The icon has no text, so screen readers get the full meaning from the label.
    private string AriaLabel => Notifications.UnreadCount switch
    {
        0 => "Notifications",
        1 => "Notifications, 1 unread",
        var n => $"Notifications, {n} unread",
    };

    protected override async Task OnInitializedAsync()
    {
        Notifications.Changed += OnChanged;
        Live.NotificationsChanged += OnHint;
        Live.Reconnected += OnHint;

        await Notifications.RefreshAsync();
        _ = Live.EnsureStartedAsync();
        _ = PollAsync();
    }

    // The server says this user's notifications changed: fetch the new count. Like a
    // socket.on("...") handler that invalidates a query instead of carrying the data.
    private void OnHint() => _ = Notifications.RefreshAsync();

    // Like setInterval in a useEffect, with the cleanup in Dispose. The bell only exists
    // while signed in (it's inside <Authorized>), so this stops on sign-out. While the live
    // connection is up each tick does nothing; while it's down, the tick polls and tries
    // to reconnect, so the bell is never more than 30 s stale.
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (!Live.IsConnected)
                {
                    await Notifications.RefreshAsync();
                    await Live.EnsureStartedAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Changed can fire from outside this component's render cycle, so marshal the
    // re-render through InvokeAsync.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Notifications.Changed -= OnChanged;
        Live.NotificationsChanged -= OnHint;
        Live.Reconnected -= OnHint;
        _stop.Cancel();
        _stop.Dispose();
    }
}
