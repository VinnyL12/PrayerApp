@inject PrayerApiClient Api
@inject TimeProvider Time

<article class="card post @(ShowUrgent ? "post-urgent" : "")">
    <header class="post-meta">
        <span class="author">@AuthorLabel</span>
        <span class="muted">· @TimeFormat.Ago(Post.CreatedAt, Time.GetUtcNow())</span>
        @if (ShowUrgent)
        {
            <span class="tag tag-urgent">Urgent</span>
        }
        @if (Post.Status == PostStatus.Answered)
        {
            <span class="tag tag-answered">Answered</span>
        }
        @if (Post.Status == PostStatus.Archived)
        {
            <span class="tag">Archived</span>
        }
    </header>

    @if (ShowLink)
    {
        <a class="post-body post-link" href="/posts/@Post.Id">@Post.Body</a>
    }
    else
    {
        <p class="post-body">@Post.Body</p>
    }

    @* The API turns an archived post's image URL off, so don't render a broken image. *@
    @if (Post.ImageId is { } imageId && Post.Status != PostStatus.Archived)
    {
        <img class="post-image @(ShowLink ? "" : "post-image-full")" src="@Api.ImageUrl(imageId)"
             alt="Photo shared with this post" loading="lazy" />
    }

    @if (Post.Link is { } link)
    {
        @* noopener: the new tab can't script this one. noreferrer: the site doesn't learn
           which post sent the reader. nofollow ugc: user content, not an endorsement. *@
        <a class="post-link-card" href="@link" target="_blank" rel="noopener noreferrer nofollow ugc">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" /><path d="M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" /></svg>
            <span class="post-link-text">
                <span class="post-link-title">@PostLinks.Title(link)</span>
                <span class="muted small">@PostLinks.Host(link)</span>
            </span>
            <span class="visually-hidden">(opens in a new tab)</span>
        </a>
    }

    <footer class="post-footer">
        <span class="muted">@ResponseCount</span>

        @if (Post.IsMine)
        {
            <span class="muted small">Your post</span>
        }
        else if (Post.MyAcknowledgment is { } mine)
        {
            if (_changing)
            {
                <div class="ack-picker" role="group" aria-label="Change your response">
                    @foreach (var type in AcknowledgmentPolicy.AllowedFor(Post.CommunityCategory, Post.Status))
                    {
                        <button class="chip @(type == mine ? "chip-selected" : "")" disabled="@(_busy || type == mine)"
                                aria-pressed="@(type == mine)" @onclick="() => ChangeAsync(type)">@type.ToLabel()</button>
                    }
                    <button class="link-button quiet" disabled="@_busy" @onclick="() => _changing = false">Cancel</button>
                </div>
            }
            else
            {
                <div class="ack-actions">
                    <span class="acknowledged"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>@mine.ToLabel()</span>
                    <button class="link-button quiet" disabled="@_busy" @onclick="() => _changing = true">Change</button>
                    <button class="link-button quiet" disabled="@_busy" @onclick="RemoveAsync">Remove</button>
                </div>
            }
        }
        else if (Post.Status != PostStatus.Archived)
        {
            <div class="ack-picker" role="group" aria-label="Respond to this post">
                @foreach (var type in AcknowledgmentPolicy.AllowedFor(Post.CommunityCategory, Post.Status))
                {
                    <button class="chip" disabled="@_busy" @onclick="() => AcknowledgeAsync(type)">@type.ToLabel()</button>
                }
            </div>
        }
    </footer>

    @if (_error is not null)
    {
        <p class="error small">@_error</p>
    }
</article>

@code {
    // [Parameter] is a prop. EventCallback is a callback prop (onChange={...}).
    [Parameter, EditorRequired] public PostDto Post { get; set; } = default!;
    [Parameter] public EventCallback<PostDto> PostChanged { get; set; }
    [Parameter] public bool ShowLink { get; set; } = true;

    private bool _busy;
    private bool _changing;
    private string? _error;

    // Urgency is about the wait. Once a post is answered (or archived) it's over.
    private bool ShowUrgent => Post.IsUrgent && Post.Status == PostStatus.Active;

    private string AuthorLabel => (Post.IsMine, Post.IsAnonymous) switch
    {
        (true, true) => "You (posted anonymously)",
        (true, false) => "You",
        _ => Post.AuthorDisplayName ?? "Anonymous",
    };

    private string ResponseCount => Post.AcknowledgmentCount switch
    {
        0 => "No responses yet",
        1 => "1 person responded",
        var n => $"{n} people responded",
    };

    private async Task AcknowledgeAsync(AcknowledgmentType type)
    {
        _busy = true;
        _error = null;

        var result = await Api.AcknowledgeAsync(Post.Id, type);
        if (result.Succeeded)
        {
            // Records are immutable; "with" makes an updated copy, like {...post, count}.
            // The parent owns the list, so hand the new version up rather than mutating.
            await PostChanged.InvokeAsync(Post with
            {
                AcknowledgmentCount = result.Value!.AcknowledgmentCount,
                MyAcknowledgment = type,
            });
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private async Task ChangeAsync(AcknowledgmentType type)
    {
        _busy = true;
        _error = null;

        var result = await Api.ChangeAcknowledgmentAsync(Post.Id, type);
        if (result.Succeeded)
        {
            _changing = false;
            await PostChanged.InvokeAsync(Post with
            {
                AcknowledgmentCount = result.Value!.AcknowledgmentCount,
                MyAcknowledgment = type,
            });
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    private async Task RemoveAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.RemoveAcknowledgmentAsync(Post.Id);
        if (result.Succeeded)
        {
            // Back to the picker, so responding again is one tap.
            await PostChanged.InvokeAsync(Post with
            {
                AcknowledgmentCount = result.Value!.AcknowledgmentCount,
                MyAcknowledgment = null,
            });
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }
}
